# ---- Pinecone 向量库 ----
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=
PINECONE_INDEX=kb-cloud

# ---- Cloudflare R2 存储 ----
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_ORIGINALS=kb-originals
R2_BUCKET_EXTRACTED=kb-extracted

# ---- Jina AI（嵌入）----
JINA_API_KEY=your_jina_api_key
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_DIM=1024

# ---- 全网搜索 ----
# Serper.dev（Google 搜索，2500次/月免费）—— https://serper.dev 注册
# 不配置则降级用 DuckDuckGo（免费但可能受限）
SERPER_API_KEY=

# ---- Supabase Auth ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_ENABLE_AUTH=true

# ---- 本地迁移（仅首次导入时使用）----
LOCAL_KB_DIR=/path/to/your/local/kb_src
